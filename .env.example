# Application Configuration
NODE_ENV=development
PORT=5001

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/api_monitor

# Configurable Latency Thresholds (in milliseconds)
SLOW_THRESHOLD_MS=3000
VERY_SLOW_THRESHOLD_MS=5000

# LLM Provider (gemini or openai)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=10000
LLM_CONCURRENCY=5

# Optional Email Digest Notifications (Nodemailer SMTP)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@api-monitor.local
ALERT_RECIPIENT_EMAIL=
